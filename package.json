{
  "name": "entra-proxy-frontend",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main/typescript/*.ts --bundle --splitting --format=esm --target=es2022 --outdir=build/generated/frontend/static",
    "lint": "eslint .",
    "test": "npm run lint && npm run build && npm run test:frontend",
    "test:frontend": "tsc -p tsconfig.test.json && playwright test",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  }
}

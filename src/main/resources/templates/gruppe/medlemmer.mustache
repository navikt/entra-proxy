<!doctype html>
<html lang="nb">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Medlemmer i Entra-grupper</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@navikt/ds-css@8.16.2/dist/index.css">
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: #f3f3f4;
            color: #1f1f1f;
            font-family: Arial, sans-serif;
        }
        main {
            max-width: 90rem;
            margin: 2rem auto;
            padding: 2rem;
            background: #fff;
            border: 1px solid #d1d6db;
            border-radius: 8px;
        }
        #sok {
            display: flex;
            gap: 2rem;
            overflow-x: auto;
            padding-bottom: 1rem;
        }
        .sok-panel {
            flex: 0 0 28rem;
            min-width: 0;
        }
        .sok-knapper {
            display: flex;
            gap: 0.75rem;
            margin-top: 1rem;
        }
        .nytt-sok { margin-left: auto; }
        .status { min-height: 1.5rem; margin-top: 1rem; }
        .status.error { color: #a40000; }
        .medlemmer {
            background: #f3f3f4;
            list-style: none;
            padding-left: 0;
            max-height: min(24rem, 50vh);
            overflow-x: auto;
            overflow-y: scroll;
            scrollbar-gutter: stable;
        }
        .oppsummering {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }
        .oppsummering th,
        .oppsummering td {
            padding: 0.75rem;
            border-bottom: 1px solid #d1d6db;
        }
        .oppsummering td:last-child,
        .oppsummering th:last-child {
            text-align: right;
        }
        li { margin-bottom: 0.5rem; overflow-wrap: anywhere; }
    </style>
</head>
<body>
<main>
    <h1 class="aksel-heading aksel-heading--large">Medlemmer i Entra-grupper</h1>
    <div id="sok">
    <section class="sok-panel" aria-label="Gruppesøk 1">
    <form id="gruppe-form">
        <div class="aksel-form-field" style="margin-top: 1rem;">
            <label class="aksel-label" for="gruppeNavn">Gruppenavn</label>
            <input class="aksel-text-field__input" id="gruppeNavn" name="gruppeNavn" type="text" required placeholder="Skriv inn gruppenavn">
        </div>
        <div class="sok-knapper">
            <button class="aksel-button" data-variant="primary" data-color="brand-blue" id="vis-medlemmer" type="submit">Vis medlemmer</button>
            <button class="aksel-button nytt-sok" data-variant="secondary" data-color="brand-blue" type="button">Nytt s&#248;k</button>
        </div>
    </form>
    <p class="aksel-body-short status" id="status" role="status" aria-live="polite"></p>
    <ul class="aksel-body-short medlemmer" id="medlemmer" aria-label="Gruppemedlemmer" tabindex="0"></ul>
    </section>
    </div>
    <section id="felles-resultat" aria-labelledby="felles-overskrift" hidden>
        <h2 class="aksel-heading aksel-heading--medium" id="felles-overskrift">Oppsummering av gruppemedlemskap</h2>
        <p class="aksel-body-short status" id="felles-status" role="status" aria-live="polite"></p>
        <table class="oppsummering">
            <thead>
            <tr><th scope="col">Grupper</th><th scope="col">Antall medlemmer</th></tr>
            </thead>
            <tbody id="felles-medlemmer"></tbody>
        </table>
    </section>
</main>
<script>
    const sok = document.getElementById('sok');
    const forstePanel = sok.querySelector('.sok-panel');
    const panelMal = forstePanel.cloneNode(true);
    const fellesResultat = document.getElementById('felles-resultat');
    const fellesStatus = document.getElementById('felles-status');
    const fellesListe = document.getElementById('felles-medlemmer');
    let antallSok = 1;

    function visMedlemmer(liste, navIdenter) {
        liste.replaceChildren();
        for (const navIdent of navIdenter) {
            const item = document.createElement('li');
            item.textContent = navIdent;
            liste.appendChild(item);
        }
    }

    function oppdaterFellesMedlemmer() {
        const paneler = [...sok.querySelectorAll('.sok-panel')];
        fellesResultat.hidden = paneler.length < 2;
        fellesListe.replaceChildren();
        if (fellesResultat.hidden) {
            return;
        }
        if (paneler.some(panel => panel.dataset.populert !== 'true')) {
            fellesStatus.textContent = 'Fullf\u00f8r et s\u00f8k i alle feltene for \u00e5 vise felles medlemmer.';
            return;
        }

        const medlemssett = paneler.map(panel =>
            new Set([...panel.querySelector('.medlemmer').children].map(item => item.textContent))
        );
        const forsteGruppe = medlemssett[0];
        const andreGrupper = medlemssett.slice(1);
        const kunForsteGruppe = [...forsteGruppe].filter(navIdent =>
            andreGrupper.every(medlemmer => !medlemmer.has(navIdent))
        );
        const oppsummeringer = [
            {grupper: `Kun i ${paneler[0].dataset.gruppeNavn}`, antall: kunForsteGruppe.length},
            ...andreGrupper.map((medlemmer, indeks) => {
                const fellesAntall = [...forsteGruppe].filter(navIdent => medlemmer.has(navIdent)).length;
                return {
                    grupper: `I ${paneler[0].dataset.gruppeNavn} og ${paneler[indeks + 1].dataset.gruppeNavn}`,
                    antall: fellesAntall
                };
            })
        ];
        fellesListe.replaceChildren();
        for (const oppsummering of oppsummeringer) {
            const rad = document.createElement('tr');
            const gruppeCelle = document.createElement('td');
            const antallCelle = document.createElement('td');
            gruppeCelle.textContent = oppsummering.grupper;
            antallCelle.textContent = oppsummering.antall;
            rad.append(gruppeCelle, antallCelle);
            fellesListe.appendChild(rad);
        }
        fellesStatus.textContent = 'Antall medlemmer basert på gruppene over.';
    }

    function klargjorSok(panel) {
        const form = panel.querySelector('form');
        const input = panel.querySelector('input');
        const button = panel.querySelector('button[type="submit"]');
        const status = panel.querySelector('.status');
        const liste = panel.querySelector('.medlemmer');

        panel.querySelector('.nytt-sok').addEventListener('click', () => {
            const nyttPanel = panelMal.cloneNode(true);
            antallSok += 1;
            nyttPanel.setAttribute('aria-label', `Gruppes\u00f8k ${antallSok}`);
            for (const element of nyttPanel.querySelectorAll('[id]')) {
                element.id = `${element.id}-${antallSok}`;
            }
            nyttPanel.querySelector('label').htmlFor = nyttPanel.querySelector('input').id;
            panel.after(nyttPanel);
            klargjorSok(nyttPanel);
            oppdaterFellesMedlemmer();
            nyttPanel.querySelector('input').focus();
        });

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const gruppeNavn = input.value.trim();
            panel.dataset.populert = 'false';
            liste.replaceChildren();
            oppdaterFellesMedlemmer();
            status.classList.remove('error');

            if (!gruppeNavn) {
                status.textContent = 'Skriv inn et gruppenavn.';
                status.classList.add('error');
                return;
            }

            button.disabled = true;
            status.textContent = 'Henter medlemmer...';

            try {
                const response = await fetch(`medlemmer?${new URLSearchParams({gruppeNavn})}`, {
                    headers: {'Accept': 'application/json'}
                });
                if (!response.ok) {
                    let melding = `Kunne ikke hente medlemmer (HTTP ${response.status}).`;
                    if (response.headers.get('content-type')?.includes('json')) {
                        const problem = await response.json();
                        melding = problem.detail ?? melding;
                    }
                    throw new Error(melding);
                }

                const medlemmer = await response.json();
                visMedlemmer(liste, medlemmer.map(medlem => medlem.navIdent));
                panel.dataset.gruppeNavn = gruppeNavn;
                panel.dataset.populert = 'true';
                status.textContent = medlemmer.length
                    ? `${medlemmer.length} medlemmer funnet.`
                    : 'Ingen medlemmer funnet. Gruppen kan v\u00e6re tom eller ikke finnes.';
            } catch (error) {
                status.textContent = `Henting feilet: ${error.message}`;
                status.classList.add('error');
            } finally {
                button.disabled = false;
                oppdaterFellesMedlemmer();
            }
        });
    }

    klargjorSok(forstePanel);
</script>
</body>
</html>
